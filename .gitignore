# Godot editor cache
/.godot/

# Rust build artifacts and compiler backups
/target/
**/*.rs.bk
*.profraw

# Local editor and operating-system files
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Allow distributable GDExtension libraries despite global binary ignores
!*.dll
!*.so
!*.dylib

# Locally built GDExtension libraries are packaged by CI, not tracked in Git.
/addons/yawc_transport/bin/*.dll

.vscode/